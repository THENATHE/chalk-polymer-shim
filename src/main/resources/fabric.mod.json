  "depends": {"minecraft": "${mc}", "java": ">=25", "fabricloader": ">=0.19.5", "fabric-api": "*", "chalk": "${chalk}", "polymer-core": "${polymer}", "polymer-resource-pack": "${polymer}", "polymer-virtual-entity": "${polymer}"}
